#!name = 库迪咖啡开屏广告拦截（激进实验版）
#!desc = 拦截库迪独立 App 的两个广告位相关接口；可能导致首页活动区域异常，出现问题请停用
#!author = LiRayX
#!date = 2026-10-29
#!tag = 库迪咖啡,去广告,实验

[Rewrite]
^https:\/\/capi\.cotticoffee\.com\/cotti-capi\/customer\/position\/adSortList(?:\?.*)?$ - reject-dict
^https:\/\/capi\.cotticoffee\.com\/cotti-capi\/customer\/position\/list(?:\?.*)?$ - reject-dict

[Mitm]
hostname = capi.cotticoffee.com
